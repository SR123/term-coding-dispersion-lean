import Mathlib
import TermCoding.Syntax

namespace TermCoding

universe uSym uVar uAlpha

namespace TermSystem

/-- A finite family of explicit variable equalities. -/
abbrev VariableEqualities (Var : Type uVar) (q : Nat) :=
  Fin q → Var × Var

/-- Satisfaction of every explicit variable equality. -/
def VariableEqualities.Holds {Var : Type uVar} {A : Type uAlpha} {q : Nat}
    (E : VariableEqualities Var q) (a : Assignment Var A) : Prop :=
  ∀ i, a (E i).1 = a (E i).2

/-- The generating relation contributed by the displayed equality pairs. -/
def equalityGenerator {Var : Type uVar} {q : Nat}
    (E : VariableEqualities Var q) (x y : Var) : Prop :=
  ∃ i, E i = (x, y)

/-- The equivalence relation generated by a finite family of variable
equalities. -/
def equalitySetoid {Var : Type uVar} {q : Nat}
    (E : VariableEqualities Var q) : Setoid Var :=
  Relation.EqvGen.setoid (equalityGenerator E)

/-- Replace every variable of a normal-form system by its class under a
setoid. Using quotient classes avoids any hidden representative choice. -/
def variableQuotient {σ : Signature.{uSym}} {Var : Type uVar} {m : Nat}
    (Γ : TermSystem σ Var m) (r : Setoid Var) :
    TermSystem σ (Quotient r) m :=
  fun i =>
    { symbol := (Γ i).symbol
      args := fun p => Quotient.mk r ((Γ i).args p)
      output := Quotient.mk r (Γ i).output }

/-- Pull an assignment on quotient classes back to the original variables. -/
def pullbackAssignment {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment (Quotient r) A) : Assignment Var A :=
  fun v => a (Quotient.mk r v)

/-- An assignment is compatible with a variable quotient when it is constant
on every equivalence class. -/
def Compatible {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment Var A) : Prop :=
  ∀ x y, r.r x y → a x = a y

/-- Satisfying the displayed variable equalities is exactly being constant on
the classes of their generated equivalence relation. -/
theorem variableEqualities_holds_iff_compatible
    {Var : Type uVar} {A : Type uAlpha} {q : Nat}
    (E : VariableEqualities Var q) (a : Assignment Var A) :
    E.Holds a ↔ Compatible (equalitySetoid E) a := by
  constructor
  · intro hE x y hxy
    change Relation.EqvGen (equalityGenerator E) x y at hxy
    induction hxy with
    | rel x y hrel =>
        obtain ⟨i, hi⟩ := hrel
        have hpairs := congrArg (fun pair : Var × Var => a pair.1 = a pair.2) hi
        exact hpairs.mp (hE i)
    | refl x => rfl
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ ihxy ihyz => exact ihxy.trans ihyz
  · intro hcompat i
    exact hcompat (E i).1 (E i).2
      (Relation.EqvGen.rel _ _ ⟨i, rfl⟩)

/-- Descend a class-compatible assignment to the quotient variables. -/
def descendAssignment {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment Var A) (h : Compatible r a) :
    Assignment (Quotient r) A :=
  fun q => Quotient.liftOn q a (fun x y hxy => h x y hxy)

/-- Satisfaction after quotienting is definitionally satisfaction of the
original defining equations by the pulled-back assignment. -/
theorem variableQuotient_holds_iff {σ : Signature.{uSym}}
    {Var : Type uVar} {A : Type uAlpha} {m : Nat}
    (Γ : TermSystem σ Var m) (r : Setoid Var) (I : Interpretation σ A)
    (a : Assignment (Quotient r) A) :
    Holds (variableQuotient Γ r) I a ↔ Holds Γ I (pullbackAssignment r a) := by
  rfl

/-- Pulling back an assignment from quotient classes is automatically
compatible with the quotient relation. -/
theorem pullback_compatible {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment (Quotient r) A) :
    Compatible r (pullbackAssignment r a) := by
  intro x y hxy
  exact congrArg a (Quotient.sound hxy)

/-- Pullback after descent recovers the original compatible assignment. -/
theorem pullback_descend {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment Var A) (h : Compatible r a) :
    pullbackAssignment r (descendAssignment r a h) = a := by
  funext v
  rfl

/-- Descent after pullback recovers the quotient assignment. -/
theorem descend_pullback {Var : Type uVar} {A : Type uAlpha}
    (r : Setoid Var) (a : Assignment (Quotient r) A) :
    descendAssignment r (pullbackAssignment r a) (pullback_compatible r a) = a := by
  funext q
  induction q using Quotient.inductionOn with
  | _ v => rfl

/-- Exact solution equivalence for variable quotienting. The right-hand side
records explicitly the class-compatibility condition that variable equalities
enforce before they are removed. -/
def variableQuotientSolutionsEquiv {σ : Signature.{uSym}}
    {Var : Type uVar} {A : Type uAlpha} {m : Nat}
    (Γ : TermSystem σ Var m) (r : Setoid Var) (I : Interpretation σ A) :
    TypeEquiv (Solutions (variableQuotient Γ r) I)
      {a : Assignment Var A // Holds Γ I a ∧ Compatible r a} where
  toFun a :=
    ⟨pullbackAssignment r a.1,
      ⟨(variableQuotient_holds_iff Γ r I a.1).1 a.2,
        pullback_compatible r a.1⟩⟩
  invFun a :=
    ⟨descendAssignment r a.1 a.2.2,
      (variableQuotient_holds_iff Γ r I
        (descendAssignment r a.1 a.2.2)).2 (by
          rw [pullback_descend]
          exact a.2.1)⟩
  left_inv a := by
    apply Subtype.ext
    exact descend_pullback r a.1
  right_inv a := by
    apply Subtype.ext
    exact pullback_descend r a.1 a.2.2

/-- Lemma 3.5 in explicit semantic form: solutions of the defining equations
plus finite variable equalities are equivalent to solutions of the quotient
system, for every fixed interpretation. -/
def explicitEqualitiesSolutionsEquiv {σ : Signature.{uSym}}
    {Var : Type uVar} {A : Type uAlpha} {m q : Nat}
    (Γ : TermSystem σ Var m) (E : VariableEqualities Var q)
    (I : Interpretation σ A) :
    TypeEquiv
      {a : Assignment Var A // Holds Γ I a ∧ E.Holds a}
      (Solutions (variableQuotient Γ (equalitySetoid E)) I) where
  toFun a :=
    ⟨descendAssignment (equalitySetoid E) a.1
        ((variableEqualities_holds_iff_compatible E a.1).1 a.2.2),
      (variableQuotient_holds_iff Γ (equalitySetoid E) I _).2 (by
        rw [pullback_descend]
        exact a.2.1)⟩
  invFun a :=
    ⟨pullbackAssignment (equalitySetoid E) a.1,
      ⟨(variableQuotient_holds_iff Γ (equalitySetoid E) I a.1).1 a.2,
        (variableEqualities_holds_iff_compatible E _).2
          (pullback_compatible (equalitySetoid E) a.1)⟩⟩
  left_inv a := by
    apply Subtype.ext
    exact pullback_descend (equalitySetoid E) a.1
      ((variableEqualities_holds_iff_compatible E a.1).1 a.2.2)
  right_inv a := by
    apply Subtype.ext
    exact descend_pullback (equalitySetoid E) a.1

end TermSystem

end TermCoding
